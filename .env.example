# Salin menjadi .env.local (pengembangan lokal) atau isi di Vercel → Settings → Environment Variables.
# Nilainya ada di Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration.

# ── Wajib ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Alamat Realtime Database, contoh: https://nama-proyek-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Opsional ──
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=